datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum CondicionIva {
  RESPONSABLE_INSCRIPTO
  MONOTRIBUTO
  EXENTO
  CONSUMIDOR_FINAL
  NO_RESPONSABLE
}

model Empresa {
  id                 String       @id @default(uuid()) @db.Uuid
  razonSocial        String
  cuit               String
  condicionIva       CondicionIva
  domicilio          String?
  inicioEjercicioMes Int          @default(1)
  activa             Boolean      @default(true)
  creadoEn           DateTime     @default(now())

  agenteRetencionGanancias Boolean  @default(false)
  agenteRetencionIva       Boolean  @default(false)
  agenteRetencionSuss      Boolean  @default(false)
  jurisdiccionesIibb       String[]

  montoAprobacionOc     Decimal      @default(0) @db.Decimal(18, 2)
  toleranciaPrecioPct   Decimal      @default(2) @db.Decimal(18, 6)
  toleranciaCantidadPct Decimal      @default(0) @db.Decimal(18, 6)
  modoTresVias          ModoTresVias @default(AVISAR)

  puntosVenta PuntoVenta[]
  roles       Rol[]
  usuarios    UsuarioEmpresa[]
  cuentas     CuentaContable[]
}

model PuntoVenta {
  id          String  @id @default(uuid()) @db.Uuid
  empresaId   String  @db.Uuid
  numero      Int
  descripcion String?
  empresa     Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, numero])
}

model Usuario {
  id           String           @id @default(uuid()) @db.Uuid
  email        String           @unique
  nombre       String
  passwordHash String
  superadmin   Boolean          @default(false)
  activo       Boolean          @default(true)
  creadoEn     DateTime         @default(now())
  empresas     UsuarioEmpresa[]
}

model Rol {
  id        String           @id @default(uuid()) @db.Uuid
  empresaId String           @db.Uuid
  nombre    String
  permisos  String[]
  empresa   Empresa          @relation(fields: [empresaId], references: [id])
  usuarios  UsuarioEmpresa[]

  @@unique([empresaId, nombre])
}

model UsuarioEmpresa {
  usuarioId String  @db.Uuid
  empresaId String  @db.Uuid
  rolId     String  @db.Uuid
  activo    Boolean @default(true)
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  empresa   Empresa @relation(fields: [empresaId], references: [id])
  rol       Rol     @relation(fields: [rolId], references: [id])

  @@id([usuarioId, empresaId])
}

model Auditoria {
  id        String   @id @default(uuid()) @db.Uuid
  empresaId String   @db.Uuid
  usuarioId String   @db.Uuid
  entidad   String
  entidadId String
  accion    String
  datos     Json?
  fecha     DateTime @default(now())

  @@index([empresaId, entidad, entidadId])
}

model Talonario {
  id              String @id @default(uuid()) @db.Uuid
  empresaId       String @db.Uuid
  tipoComprobante String
  puntoVenta      Int
  ultimoNumero    Int    @default(0)

  @@unique([empresaId, tipoComprobante, puntoVenta])
}

model Tercero {
  id               String       @id @default(uuid()) @db.Uuid
  empresaId        String       @db.Uuid
  codigo           Int
  razonSocial      String
  nombreFantasia   String?
  cuit             String
  condicionIva     CondicionIva
  esProveedor      Boolean      @default(false)
  esCliente        Boolean      @default(false)
  domicilio        String?
  localidad        String?
  provincia        String?
  email            String?
  telefono         String?
  diasPago         Int          @default(0)
  regimenGanancias String?
  exentoGanancias  Boolean      @default(false)
  exentoIva        Boolean      @default(false)
  exencionHasta    DateTime?    @db.Date
  activo           Boolean      @default(true)
  creadoEn         DateTime     @default(now())
  iibb             TerceroIibb[]

  @@unique([empresaId, cuit])
  @@unique([empresaId, codigo])
}

model TerceroIibb {
  id                 String  @id @default(uuid()) @db.Uuid
  empresaId          String  @db.Uuid
  terceroId          String  @db.Uuid
  jurisdiccion       String
  alicuotaPercepcion Decimal @db.Decimal(18, 6)
  alicuotaRetencion  Decimal @db.Decimal(18, 6)
  exento             Boolean @default(false)
  tercero            Tercero @relation(fields: [terceroId], references: [id], onDelete: Cascade)

  @@unique([terceroId, jurisdiccion])
}

enum TipoCuenta {
  ACTIVO
  PASIVO
  PATRIMONIO_NETO
  RESULTADO_POSITIVO
  RESULTADO_NEGATIVO
}

model CuentaContable {
  id        String           @id @default(uuid()) @db.Uuid
  empresaId String           @db.Uuid
  codigo    String
  nombre    String
  padreId   String?          @db.Uuid
  imputable Boolean
  tipo      TipoCuenta
  activa    Boolean          @default(true)
  empresa   Empresa          @relation(fields: [empresaId], references: [id])
  padre     CuentaContable?  @relation("Jerarquia", fields: [padreId], references: [id])
  hijos     CuentaContable[] @relation("Jerarquia")

  @@unique([empresaId, codigo])
}

model Articulo {
  id            String  @id @default(uuid()) @db.Uuid
  empresaId     String  @db.Uuid
  codigo        String
  descripcion   String
  unidad        String  @default("UN")
  alicuotaIva   Decimal @db.Decimal(18, 6)
  cuentaCompraId String? @db.Uuid
  cuentaVentaId String? @db.Uuid
  esServicio    Boolean @default(false)
  activo        Boolean @default(true)

  @@unique([empresaId, codigo])
}

model Moneda {
  codigo  String @id
  nombre  String
  simbolo String
}

model Cotizacion {
  id           String   @id @default(uuid()) @db.Uuid
  empresaId    String   @db.Uuid
  monedaCodigo String
  fecha        DateTime @db.Date
  valor        Decimal  @db.Decimal(18, 6)

  @@unique([empresaId, monedaCodigo, fecha])
}

model CentroCosto {
  id        String  @id @default(uuid()) @db.Uuid
  empresaId String  @db.Uuid
  codigo    String
  nombre    String
  activo    Boolean @default(true)

  @@unique([empresaId, codigo])
}

model Deposito {
  id        String  @id @default(uuid()) @db.Uuid
  empresaId String  @db.Uuid
  codigo    String
  nombre    String
  direccion String?
  activo    Boolean @default(true)

  @@unique([empresaId, codigo])
}

enum TipoChequera {
  FISICA
  ECHEQ
}

model Banco {
  id         String           @id @default(uuid()) @db.Uuid
  empresaId  String           @db.Uuid
  nombre     String
  codigoBcra String?
  cuentas    CuentaBancaria[]
}

model CuentaBancaria {
  id               String     @id @default(uuid()) @db.Uuid
  empresaId        String     @db.Uuid
  bancoId          String     @db.Uuid
  numero           String
  cbu              String?
  alias            String?
  monedaCodigo     String
  cuentaContableId String     @db.Uuid
  activa           Boolean    @default(true)
  banco            Banco      @relation(fields: [bancoId], references: [id])
  chequeras        Chequera[]
}

model Chequera {
  id               String         @id @default(uuid()) @db.Uuid
  empresaId        String         @db.Uuid
  cuentaBancariaId String         @db.Uuid
  tipo             TipoChequera
  desde            Int?
  hasta            Int?
  proximoNumero    Int?
  activa           Boolean        @default(true)
  cuentaBancaria   CuentaBancaria @relation(fields: [cuentaBancariaId], references: [id])
}

model Caja {
  id               String  @id @default(uuid()) @db.Uuid
  empresaId        String  @db.Uuid
  nombre           String
  monedaCodigo     String
  cuentaContableId String  @db.Uuid
  activa           Boolean @default(true)
}

enum ModoTresVias {
  AVISAR
  BLOQUEAR
}

model ConfigCuenta {
  id               String @id @default(uuid()) @db.Uuid
  empresaId        String @db.Uuid
  concepto         String
  cuentaContableId String @db.Uuid

  @@unique([empresaId, concepto])
}
