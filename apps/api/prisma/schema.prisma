  importe       Decimal              @db.Decimal(18, 2)
}

enum TipoVendedor {
  EMPLEADO
  EXTERNO
}

enum EstadoLiquidacionComisiones {
  CONFIRMADA
  ANULADA
}

enum TipoRenglonComision {
  COBRO
  ANULACION
  RECHAZO
}

/// Vendedor que cobra comisión sobre lo cobrado (Entrega 24).
model Vendedor {
  id          String       @id @default(uuid()) @db.Uuid
  empresaId   String       @db.Uuid
  nombre      String
  tipo        TipoVendedor
  porcentaje  Decimal      @db.Decimal(5, 2)
  empleadoId  String?      @db.Uuid
  proveedorId String?      @db.Uuid
  activo      Boolean      @default(true)

  @@unique([empresaId, nombre])
  @@unique([empresaId, empleadoId])
  @@unique([empresaId, proveedorId])
}

model LiquidacionComisiones {
  id              String                         @id @default(uuid()) @db.Uuid
  empresaId       String                         @db.Uuid
  numero          Int
  anio            Int
  mes             Int
  fecha           DateTime                       @db.Date
  estado          EstadoLiquidacionComisiones    @default(CONFIRMADA)
  motivoAnulacion String?
  creadoPor       String
  creadoEn        DateTime                       @default(now())
  renglones       LiquidacionComisionesRenglon[]

  @@unique([empresaId, numero])
  @@index([empresaId, anio, mes])
}

model LiquidacionComisionesRenglon {
  id            String                @id @default(uuid()) @db.Uuid
  empresaId     String                @db.Uuid
  liquidacionId String                @db.Uuid
  liquidacion   LiquidacionComisiones @relation(fields: [liquidacionId], references: [id], onDelete: Cascade)
  vendedorId    String                @db.Uuid
  tipo          TipoRenglonComision
  aplicacionId  String                @db.Uuid
  comprobanteId String                @db.Uuid
  chequeId      String?               @db.Uuid
  cobrado       Decimal               @db.Decimal(18, 2)
  neto          Decimal               @db.Decimal(18, 2)
  porcentaje    Decimal               @db.Decimal(5, 2)
  comision      Decimal               @db.Decimal(18, 2)
  anulado       Boolean               @default(false)

  @@index([empresaId, aplicacionId])
  @@index([empresaId, liquidacionId])
}

enum MedioGestion {
  LLAMADO
  MAIL
  WHATSAPP
  VISITA
  OTRO
}

/// Gestión de cobranza sobre un cliente, con próxima acción y promesa de pago opcionales (Entrega 25).
model GestionCobranza {
  id             String       @id @default(uuid()) @db.Uuid
  empresaId      String       @db.Uuid
  terceroId      String       @db.Uuid
  fecha          DateTime     @db.Date
  medio          MedioGestion
  nota           String
  proximaAccion  DateTime?    @db.Date
  promesaFecha   DateTime?    @db.Date
  promesaImporte Decimal?     @db.Decimal(18, 2)
  creadoPor      String
  creadoEn       DateTime     @default(now())

  @@index([empresaId, terceroId, fecha])
}

/// Tasa de intereses por mora de la empresa (Entrega 27).
model ConfigIntereses {
  id          String  @id @default(uuid()) @db.Uuid
  empresaId   String  @unique @db.Uuid
  tasaMensual Decimal @db.Decimal(5, 2)
  descripcion String  @default("Intereses por mora")
}

model LiquidacionIntereses {
  id        String                        @id @default(uuid()) @db.Uuid
  empresaId String                        @db.Uuid
  numero    Int
  anio      Int
  mes       Int
  tasa      Decimal                       @db.Decimal(5, 2)
  fecha     DateTime                      @db.Date
  creadoPor String
  creadoEn  DateTime                      @default(now())
  renglones LiquidacionInteresesRenglon[]

  @@unique([empresaId, numero])
}

model LiquidacionInteresesRenglon {
  id            String               @id @default(uuid()) @db.Uuid
  empresaId     String               @db.Uuid
  liquidacionId String               @db.Uuid
  liquidacion   LiquidacionIntereses @relation(fields: [liquidacionId], references: [id], onDelete: Cascade)
  comprobanteId String               @db.Uuid
  terceroId     String               @db.Uuid
  monedaCodigo  String
  saldo         Decimal              @db.Decimal(18, 2)
  dias          Int
  interes       Decimal              @db.Decimal(18, 2)
  alicuota      String
  /// Nota de débito que factura el interés (sin clave foránea: si se elimina el borrador, el renglón queda libre)
  notaDebitoId  String?              @db.Uuid

  @@index([empresaId, comprobanteId])
  @@index([notaDebitoId])
}

/// Correo saliente de la empresa (Entrega 28). La clave se guarda cifrada con ARCA_CLAVE_MAESTRA.
model ConfigCorreo {
  id              String  @id @default(uuid()) @db.Uuid
  empresaId       String  @unique @db.Uuid
  servidor        String
  puerto          Int     @default(587)
  seguro          Boolean @default(false)
  usuario         String
  claveCifrada    String
  remitenteNombre String
  remitenteEmail  String
  asunto          String
  cuerpo          String
}

// Ganancias de cuarta categoría (E31): tablas de ARCA por semestre, importes anuales
model TablaGanancias {
  id                String           @id @default(uuid()) @db.Uuid
  empresaId         String           @db.Uuid
  anio              Int
  semestre          Int
  gni               Decimal          @db.Decimal(18, 2)
  deduccionEspecial Decimal          @db.Decimal(18, 2)
  conyuge           Decimal          @db.Decimal(18, 2)
  hijo              Decimal          @db.Decimal(18, 2)
  hijoIncapacitado  Decimal          @db.Decimal(18, 2)
  topeHipotecario   Decimal          @db.Decimal(18, 2)
  topeSeguroMuerte  Decimal          @db.Decimal(18, 2)
  topeSeguroMixto   Decimal          @db.Decimal(18, 2)
  topeSeguroRetiro  Decimal          @db.Decimal(18, 2)
  topeSepelio       Decimal          @db.Decimal(18, 2)
  tramos            TramoGanancias[]

  @@unique([empresaId, anio, semestre])
}

// Escala del art. 94 (anual)
model TramoGanancias {
  id         String         @id @default(uuid()) @db.Uuid
  empresaId  String         @db.Uuid
  tablaId    String         @db.Uuid
  tabla      TablaGanancias @relation(fields: [tablaId], references: [id], onDelete: Cascade)
  desde      Decimal        @db.Decimal(18, 2)
  hasta      Decimal?       @db.Decimal(18, 2)
  fijo       Decimal        @db.Decimal(18, 2)
  porcentaje Decimal        @db.Decimal(7, 4)

  @@index([tablaId])
}

// F.572 web (SiRADIG) de un empleado y año
model F572 {
  id              String    @id @default(uuid()) @db.Uuid
  empresaId       String    @db.Uuid
  empleadoId      String    @db.Uuid
  anio            Int
  nroPresentacion Int       @default(0)
  fecha           DateTime? @db.Date
  origen          String
  modificadoAMano Boolean   @default(false)
  datos           Json

  @@unique([empleadoId, anio])
  @@index([empresaId])
}

// Acumulado de Ganancias pagado fuera del sistema (puesta en marcha a mitad de año)
model AcumuladoGanancias {
  id         String  @id @default(uuid()) @db.Uuid
  empresaId  String  @db.Uuid
  empleadoId String  @db.Uuid
  anio       Int
  bruta      Decimal @default(0) @db.Decimal(18, 2)
  aportes    Decimal @default(0) @db.Decimal(18, 2)
  retenido   Decimal @default(0) @db.Decimal(18, 2)

  @@unique([empleadoId, anio])
  @@index([empresaId])
}

enum RubroExentoGanancias {
  ASIGNACIONES_FAMILIARES
  INTERESES_PRESTAMOS
  INDEMNIZACIONES
  CURSOS_SEMINARIOS
  INDUMENTARIA
}

// Liquidación anual de Ganancias de cuarta (E32 §5)
model LiquidacionAnualGanancias {
  id         String                              @id @default(uuid()) @db.Uuid
  empresaId  String                              @db.Uuid
  anio       Int
  estado     String                              @default("BORRADOR")
  cerradoEn  DateTime?
  cerradoPor String?
  empleados  LiquidacionAnualGananciasEmpleado[]

  @@unique([empresaId, anio])
}

model LiquidacionAnualGananciasEmpleado {
  id                 String                    @id @default(uuid()) @db.Uuid
  empresaId          String                    @db.Uuid
  anualId            String                    @db.Uuid
  anual              LiquidacionAnualGanancias @relation(fields: [anualId], references: [id], onDelete: Cascade)
  empleadoId         String                    @db.Uuid
  // Distracto (egreso de enero a marzo del año siguiente): se liquida con la final (E32 §6)
  distracto          Boolean                   @default(false)
  liquidacionFinalId String?                   @db.Uuid
  hoja               Json
  f1359              Json
  impuesto           Decimal                   @db.Decimal(18, 2)
  retenido           Decimal                   @db.Decimal(18, 2)
  pagosACuenta       Decimal                   @db.Decimal(18, 2)
  saldo              Decimal                   @db.Decimal(18, 2)

  @@unique([anualId, empleadoId])
  @@index([empresaId])
}

/// Intento fallido de login (E36): global, sin empresa. clave = 'email:<email>' o 'ip:<ip>'.
model IntentoLogin {
  id       String   @id @default(uuid()) @db.Uuid
  clave    String
  creadoEn DateTime

  @@index([clave, creadoEn])
}

/// Percepción practicada en un comprobante de venta (E39): IIBB por jurisdicción o IVA por tramo, en la moneda del comprobante.
model ComprobanteVentaPercepcion {
  id             String           @id @default(uuid()) @db.Uuid
  empresaId      String           @db.Uuid
  comprobanteId  String           @db.Uuid
  comprobante    ComprobanteVenta @relation(fields: [comprobanteId], references: [id], onDelete: Cascade)
  tipo           String
  jurisdiccion   String?
  regimenCodigo  String?
  tramo          String?
  base           Decimal          @db.Decimal(18, 2)
  alicuota       Decimal          @db.Decimal(9, 4)
  importe        Decimal          @db.Decimal(18, 2)
  origenAlicuota String
  exclusionPct   Int?

  @@index([empresaId, comprobanteId])
}

/// Régimen de percepción de IVA de la empresa (E39): alícuotas general y reducida y mínimo de neto gravado. Uno solo activo.
model RegimenPercepcionIva {
  id               String  @id @default(uuid()) @db.Uuid
  empresaId        String  @db.Uuid
  codigo           String
  descripcion      String
  alicuotaGeneral  Decimal @db.Decimal(9, 4)
  alicuotaReducida Decimal @db.Decimal(9, 4)
  minimoNeto       Decimal @default(0) @db.Decimal(18, 2)
  activo           Boolean @default(true)

  @@unique([empresaId, codigo])
}

/// Régimen de retención de Ganancias a beneficiarios del exterior (E43): códigos del SIRE (impuesto 218) y alícuotas efectivas.
model RegimenExterior {
  id                   String   @id @default(uuid()) @db.Uuid
  empresaId            String   @db.Uuid
  codigoSire           String
  descripcion          String
  alicuotaSinCdi       Decimal  @db.Decimal(9, 4)
  codigoAlicuotaSinCdi Int
  alicuotaConCdi       Decimal? @db.Decimal(9, 4)
  codigoAlicuotaConCdi Int?
  activo               Boolean  @default(true)

  @@unique([empresaId, descripcion])
}

enum EstadoDjGanancias {
  BORRADOR
  PRESENTADA
}

/// Escala de Ganancias de sociedades (art. 73) de un año (E46): tramos con monto fijo y alícuota sobre el excedente.
model EscalaSociedades {
  id        String  @id @default(uuid()) @db.Uuid
  empresaId String  @db.Uuid
  anio      Int
  desde     Decimal @db.Decimal(18, 2)
  fijo      Decimal @db.Decimal(18, 2)
  alicuota  Decimal @db.Decimal(9, 4)

  @@unique([empresaId, anio, desde])
}

/// DJ anual de Ganancias de sociedades de un ejercicio (E46): datos cargados y estado.
model DjGananciasSociedades {
  id                   String            @id @default(uuid()) @db.Uuid
  empresaId            String            @db.Uuid
  ejercicioId          String            @unique @db.Uuid
  estado               EstadoDjGanancias @default(BORRADOR)
  quebrantosAnteriores Decimal           @default(0) @db.Decimal(18, 2)
  anticiposIngresados  Decimal           @default(0) @db.Decimal(18, 2)
  saldoAFavorAnterior  Decimal           @default(0) @db.Decimal(18, 2)
  impuestoCheque       Decimal           @default(0) @db.Decimal(18, 2)
  otrosPagos           Decimal           @default(0) @db.Decimal(18, 2)
}

/// Ajuste manual de la DJ de Ganancias (E46): positivo suma al resultado impositivo, negativo resta.
model DjGananciasAjuste {
  id          String   @id @default(uuid()) @db.Uuid
  empresaId   String   @db.Uuid
  ejercicioId String   @db.Uuid
  concepto    String
  importe     Decimal  @db.Decimal(18, 2)
  creadoEn    DateTime @default(now())

  @@index([empresaId, ejercicioId])
}

/// Presentación de la DJ (E46): foto de la determinación; número 0 la original, 1, 2… las rectificativas.
model DjGananciasPresentacion {
  id              String    @id @default(uuid()) @db.Uuid
  empresaId       String    @db.Uuid
  ejercicioId     String    @db.Uuid
  numero          Int
  datos           Json
  presentadaPor   String
  presentadaEn    DateTime  @default(now())
  anuladaEn       DateTime?
  anuladaPor      String?
  motivoAnulacion String?

  @@unique([empresaId, ejercicioId, numero])
}

enum TipoTitularSocio {
  PERSONA_HUMANA_PAIS
  PERSONA_HUMANA_EXTERIOR
  SUCESION_INDIVISA
  SOCIEDAD_EXTERIOR
  SOCIEDAD_PAIS
}

enum EstadoBienesPersonales {
  BORRADOR
  PRESENTADA
}

/// Registro de socios (E47): titulares de las acciones y participaciones.
model Socio {
  id            String           @id @default(uuid()) @db.Uuid
  empresaId     String           @db.Uuid
  nombre        String
  tipoDocumento String
  documento     String
  tipoTitular   TipoTitularSocio
  porcentaje    Decimal          @db.Decimal(9, 4)
  activo        Boolean          @default(true)
}

/// Liquidación anual de Bienes Personales, acciones y participaciones (E47).
model BienesPersonalesAcciones {
  id               String                 @id @default(uuid()) @db.Uuid
  empresaId        String                 @db.Uuid
  anio             Int
  ajustePatrimonio Decimal                @default(0) @db.Decimal(18, 2)
  conceptoAjuste   String?
  estado           EstadoBienesPersonales @default(BORRADOR)

  @@unique([empresaId, anio])
}

/// Participación de un socio al 31/12 del año (E47): copiada del registro y editable por año.
model BienesPersonalesParticipacion {
  id          String           @id @default(uuid()) @db.Uuid
  empresaId   String           @db.Uuid
  anio        Int
  socioId     String           @db.Uuid
  tipoTitular TipoTitularSocio
  porcentaje  Decimal          @db.Decimal(9, 4)

  @@unique([empresaId, anio, socioId])
}

/// Presentación de la liquidación (E47): foto completa; 0 la original, 1, 2… las rectificativas.
model BienesPersonalesPresentacion {
  id              String    @id @default(uuid()) @db.Uuid
  empresaId       String    @db.Uuid
  anio            Int
  numero          Int
  datos           Json
  presentadaPor   String
  presentadaEn    DateTime  @default(now())
  anuladaEn       DateTime?
  anuladaPor      String?
  motivoAnulacion String?

  @@unique([empresaId, anio, numero])
}

/// Formato del padrón de IIBB de una jurisdicción distinta de 901 y 902 (E48): común a todas las empresas, como el padrón.
/// Cada campo es el número de columna (1 = la primera) o «desde-hasta» (posiciones 1-based) en ancho fijo.
model FormatoPadron {
  id                 String  @id @default(uuid()) @db.Uuid
  jurisdiccion       String  @unique
  separador          String
  encabezado         Boolean @default(false)
  cuit               String
  alicuotaPercepcion String?
  alicuotaRetencion  String?
  vigenciaDesde      String?
  vigenciaHasta      String?
  formatoFecha       String  @default("DD/MM/AAAA")
  separadorDecimal   String  @default(".")
}

/// Recaudación bancaria de IIBB (SIRCREB) de un período y jurisdicción (E48): pago a cuenta en la liquidación de IIBB.
model RecaudacionBancaria {
  id               String  @id @default(uuid()) @db.Uuid
  empresaId        String  @db.Uuid
  periodo          String
  jurisdiccion     String
  cuentaBancariaId String? @db.Uuid
  cbu              String?
  importe          Decimal @db.Decimal(18, 2)
  referencia       String?

  @@index([empresaId, periodo])
}

/// E50: rol de la empresa en una factura de crédito MiPyME del registro de ARCA.
enum RolFce {
  EMISOR
  RECEPTOR
}

enum EstadoFceRegistro {
  PENDIENTE
  ACEPTADA
  RECHAZADA
  ACEPTADA_TACITA
}

/// E50: factura de crédito MiPyME en el registro de ARCA (emitida o recibida), por ambiente; las notas se muestran con su factura.
model FceRegistro {
  id                   String            @id @default(uuid()) @db.Uuid
  empresaId            String            @db.Uuid
  ambiente             AmbienteArca
  rol                  RolFce
  cuitContraparte      String
  cbteTipo             Int
  puntoVenta           Int
  numero               Int
  fecha                DateTime          @db.Date
  importe              Decimal           @db.Decimal(18, 2)
  moneda               String
  fechaVencimientoPago DateTime?         @db.Date
  estado               EstadoFceRegistro
  fechaRecepcion       DateTime?         @db.Date
  fechaLimite          DateTime?         @db.Date
  motivosRechazo       String[]
  textoRechazo         String?
  consultadoEn         DateTime
  comprobanteVentaId   String?           @db.Uuid
  comprobanteCompraId  String?           @db.Uuid

  @@unique([empresaId, ambiente, rol, cuitContraparte, cbteTipo, puntoVenta, numero])
  @@index([empresaId, ambiente, rol, estado])
}
