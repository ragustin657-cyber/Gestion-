datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum CondicionIva {
  RESPONSABLE_INSCRIPTO
  MONOTRIBUTO
  EXENTO
  CONSUMIDOR_FINAL
  NO_RESPONSABLE
}

model Empresa {
  id                 String       @id @default(uuid()) @db.Uuid
  razonSocial        String
  cuit               String
  condicionIva       CondicionIva
  domicilio          String?
  inicioEjercicioMes Int          @default(1)
  activa             Boolean      @default(true)
  creadoEn           DateTime     @default(now())

  agenteRetencionGanancias Boolean  @default(false)
  agenteRetencionIva       Boolean  @default(false)
  agenteRetencionSuss      Boolean  @default(false)
  jurisdiccionesIibb       String[]

  montoAprobacionOc     Decimal      @default(0) @db.Decimal(18, 2)
  toleranciaPrecioPct   Decimal      @default(2) @db.Decimal(18, 6)
  toleranciaCantidadPct Decimal      @default(0) @db.Decimal(18, 6)
  modoTresVias          ModoTresVias @default(AVISAR)
  montoAprobacionOp     Decimal      @default(0) @db.Decimal(18, 2)

  puntosVenta PuntoVenta[]
  roles       Rol[]
  usuarios    UsuarioEmpresa[]
  cuentas     CuentaContable[]
}

model PuntoVenta {
  id          String  @id @default(uuid()) @db.Uuid
  empresaId   String  @db.Uuid
  numero      Int
  descripcion String?
  empresa     Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, numero])
}

model Usuario {
  id           String           @id @default(uuid()) @db.Uuid
  email        String           @unique
  nombre       String
  passwordHash String
  superadmin   Boolean          @default(false)
  activo       Boolean          @default(true)
  creadoEn     DateTime         @default(now())
  empresas     UsuarioEmpresa[]
}

model Rol {
  id        String           @id @default(uuid()) @db.Uuid
  empresaId String           @db.Uuid
  nombre    String
  permisos  String[]
  empresa   Empresa          @relation(fields: [empresaId], references: [id])
  usuarios  UsuarioEmpresa[]

  @@unique([empresaId, nombre])
}

model UsuarioEmpresa {
  usuarioId  String  @db.Uuid
  empresaId  String  @db.Uuid
  rolId      String  @db.Uuid
  sucursalId String? @db.Uuid
  activo     Boolean @default(true)
  usuario    Usuario @relation(fields: [usuarioId], references: [id])
  empresa    Empresa @relation(fields: [empresaId], references: [id])
  rol        Rol     @relation(fields: [rolId], references: [id])

  @@id([usuarioId, empresaId])
}

model Auditoria {
  id        String   @id @default(uuid()) @db.Uuid
  empresaId String   @db.Uuid
  usuarioId String   @db.Uuid
  entidad   String
  entidadId String
  accion    String
  datos     Json?
  fecha     DateTime @default(now())

  @@index([empresaId, entidad, entidadId])
}

model Talonario {
  id              String @id @default(uuid()) @db.Uuid
  empresaId       String @db.Uuid
  tipoComprobante String
  puntoVenta      Int
  ultimoNumero    Int    @default(0)

  @@unique([empresaId, tipoComprobante, puntoVenta])
}

model Tercero {
  id                 String              @id @default(uuid()) @db.Uuid
  empresaId          String              @db.Uuid
  codigo             Int
  razonSocial        String
  nombreFantasia     String?
  cuit               String
  condicionIva       CondicionIva
  esProveedor        Boolean             @default(false)
  esCliente          Boolean             @default(false)
  domicilio          String?
  localidad          String?
  provincia          String?
  email              String?
  telefono           String?
  diasPago           Int                 @default(0)
  regimenGanancias   String?
  exentoGanancias    Boolean             @default(false)
  exentoIva          Boolean             @default(false)
  exencionHasta      DateTime?           @db.Date
  inscriptoGanancias Boolean             @default(true)
  activo             Boolean             @default(true)
  creadoEn           DateTime            @default(now())
  iibb               TerceroIibb[]
  ordenesCompra      OrdenCompra[]
  recepciones        InformeRecepcion[]
  comprobantesCompra ComprobanteCompra[]
  ordenesPago        OrdenPago[]

  @@unique([empresaId, cuit])
  @@unique([empresaId, codigo])
}

model TerceroIibb {
  id                 String  @id @default(uuid()) @db.Uuid
  empresaId          String  @db.Uuid
  terceroId          String  @db.Uuid
  jurisdiccion       String
  alicuotaPercepcion Decimal @db.Decimal(18, 6)
  alicuotaRetencion  Decimal @db.Decimal(18, 6)
  exento             Boolean @default(false)
  tercero            Tercero @relation(fields: [terceroId], references: [id], onDelete: Cascade)

  @@unique([terceroId, jurisdiccion])
}

enum TipoCuenta {
  ACTIVO
  PASIVO
  PATRIMONIO_NETO
  RESULTADO_POSITIVO
  RESULTADO_NEGATIVO
}

model CuentaContable {
  id        String           @id @default(uuid()) @db.Uuid
  empresaId String           @db.Uuid
  codigo    String
  nombre    String
  padreId   String?          @db.Uuid
  imputable Boolean
  tipo      TipoCuenta
  activa    Boolean          @default(true)
  empresa   Empresa          @relation(fields: [empresaId], references: [id])
  padre     CuentaContable?  @relation("Jerarquia", fields: [padreId], references: [id])
  hijos     CuentaContable[] @relation("Jerarquia")

  @@unique([empresaId, codigo])
}

model Articulo {
  id             String  @id @default(uuid()) @db.Uuid
  empresaId      String  @db.Uuid
  codigo         String
  descripcion    String
  unidad         String  @default("UN")
  alicuotaIva    Decimal @db.Decimal(18, 6)
  cuentaCompraId String? @db.Uuid
  cuentaVentaId  String? @db.Uuid
  esServicio     Boolean @default(false)
  activo         Boolean @default(true)

  @@unique([empresaId, codigo])
}

model Moneda {
  codigo  String @id
  nombre  String
  simbolo String
}

model Cotizacion {
  id           String   @id @default(uuid()) @db.Uuid
  empresaId    String   @db.Uuid
  monedaCodigo String
  fecha        DateTime @db.Date
  valor        Decimal  @db.Decimal(18, 6)

  @@unique([empresaId, monedaCodigo, fecha])
}

model CentroCosto {
  id        String  @id @default(uuid()) @db.Uuid
  empresaId String  @db.Uuid
  codigo    String
  nombre    String
  activo    Boolean @default(true)

  @@unique([empresaId, codigo])
}

model Deposito {
  id        String  @id @default(uuid()) @db.Uuid
  empresaId String  @db.Uuid
  codigo    String
  nombre    String
  direccion String?
  activo    Boolean @default(true)

  @@unique([empresaId, codigo])
}

enum TipoChequera {
  FISICA
  ECHEQ
}

model Banco {
  id         String           @id @default(uuid()) @db.Uuid
  empresaId  String           @db.Uuid
  nombre     String
  codigoBcra String?
  cuentas    CuentaBancaria[]
}

model CuentaBancaria {
  id               String     @id @default(uuid()) @db.Uuid
  empresaId        String     @db.Uuid
  bancoId          String     @db.Uuid
  numero           String
  cbu              String?
  alias            String?
  monedaCodigo     String
  cuentaContableId String     @db.Uuid
  activa           Boolean    @default(true)
  banco            Banco      @relation(fields: [bancoId], references: [id])
  chequeras        Chequera[]
}

model Chequera {
  id               String         @id @default(uuid()) @db.Uuid
  empresaId        String         @db.Uuid
  cuentaBancariaId String         @db.Uuid
  tipo             TipoChequera
  desde            Int?
  hasta            Int?
  proximoNumero    Int?
  activa           Boolean        @default(true)
  cuentaBancaria   CuentaBancaria @relation(fields: [cuentaBancariaId], references: [id])
}

model Sucursal {
  id        String  @id @default(uuid()) @db.Uuid
  empresaId String  @db.Uuid
  codigo    String
  nombre    String
  domicilio String?
  esCentral Boolean @default(false)
  activa    Boolean @default(true)
  cajas     Caja[]

  @@unique([empresaId, codigo])
}

model Caja {
  id               String   @id @default(uuid()) @db.Uuid
  empresaId        String   @db.Uuid
  sucursalId       String   @db.Uuid
  nombre           String
  monedaCodigo     String
  cuentaContableId String   @db.Uuid
  activa           Boolean  @default(true)
  sucursal         Sucursal @relation(fields: [sucursalId], references: [id])
}

enum ModoTresVias {
  AVISAR
  BLOQUEAR
}

model ConfigCuenta {
  id               String @id @default(uuid()) @db.Uuid
  empresaId        String @db.Uuid
  concepto         String
  cuentaContableId String @db.Uuid

  @@unique([empresaId, concepto])
}

model Asiento {
  id          String           @id @default(uuid()) @db.Uuid
  empresaId   String           @db.Uuid
  numero      Int
  fecha       DateTime         @db.Date
  descripcion String
  origenTipo  String
  origenId    String
  anulaAId    String?          @db.Uuid
  creadoPor   String
  creadoEn    DateTime         @default(now())
  renglones   AsientoRenglon[]

  @@unique([empresaId, numero])
  @@index([empresaId, origenTipo, origenId])
}

model AsientoRenglon {
  id               String  @id @default(uuid()) @db.Uuid
  empresaId        String  @db.Uuid
  asientoId        String  @db.Uuid
  cuentaContableId String  @db.Uuid
  centroCostoId    String? @db.Uuid
  debe             Decimal @default(0) @db.Decimal(18, 2)
  haber            Decimal @default(0) @db.Decimal(18, 2)
  detalle          String?
  asiento          Asiento @relation(fields: [asientoId], references: [id])
}

enum EstadoOC {
  BORRADOR
  PENDIENTE_APROBACION
  APROBADA
  PARCIALMENTE_RECIBIDA
  CUMPLIDA
  ANULADA
}

model OrdenCompra {
  id              String               @id @default(uuid()) @db.Uuid
  empresaId       String               @db.Uuid
  numero          Int?
  puntoVenta      Int                  @default(1)
  terceroId       String               @db.Uuid
  fecha           DateTime             @db.Date
  fechaEntrega    DateTime?            @db.Date
  depositoId      String?              @db.Uuid
  monedaCodigo    String
  cotizacion      Decimal              @default(1) @db.Decimal(18, 6)
  diasPago        Int                  @default(0)
  observaciones   String?
  estado          EstadoOC             @default(BORRADOR)
  neto            Decimal              @default(0) @db.Decimal(18, 2)
  iva             Decimal              @default(0) @db.Decimal(18, 2)
  total           Decimal              @default(0) @db.Decimal(18, 2)
  totalPesos      Decimal              @default(0) @db.Decimal(18, 2)
  creadoPor       String
  creadoEn        DateTime             @default(now())
  aprobadoPor     String?
  aprobadoEn      DateTime?
  motivoRechazo   String?
  motivoAnulacion String?
  cerradaEn       DateTime?
  cerradaPor      String?
  version         Int                  @default(0)
  tercero         Tercero              @relation(fields: [terceroId], references: [id])
  renglones       OrdenCompraRenglon[]

  @@unique([empresaId, puntoVenta, numero])
  @@index([empresaId, estado])
}

model OrdenCompraRenglon {
  id                String                    @id @default(uuid()) @db.Uuid
  empresaId         String                    @db.Uuid
  ordenCompraId     String                    @db.Uuid
  orden             Int
  articuloId        String?                   @db.Uuid
  descripcion       String
  cantidad          Decimal                   @db.Decimal(18, 4)
  precioUnitario    Decimal                   @db.Decimal(18, 4)
  bonificacionPct   Decimal                   @default(0) @db.Decimal(18, 6)
  alicuotaIva       Decimal                   @db.Decimal(18, 6)
  centroCostoId     String?                   @db.Uuid
  importe           Decimal                   @db.Decimal(18, 2)
  cantidadRecibida  Decimal                   @default(0) @db.Decimal(18, 4)
  cantidadFacturada Decimal                   @default(0) @db.Decimal(18, 4)
  ordenCompra       OrdenCompra               @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)
  recepciones       InformeRecepcionRenglon[]
}

enum EstadoIR {
  CONFIRMADO
  ANULADO
}

model InformeRecepcion {
  id              String                    @id @default(uuid()) @db.Uuid
  empresaId       String                    @db.Uuid
  numero          Int
  terceroId       String                    @db.Uuid
  fecha           DateTime                  @db.Date
  depositoId      String?                   @db.Uuid
  remitoNumero    String
  observaciones   String?
  estado          EstadoIR                  @default(CONFIRMADO)
  motivoAnulacion String?
  creadoPor       String
  creadoEn        DateTime                  @default(now())
  tercero         Tercero                   @relation(fields: [terceroId], references: [id])
  renglones       InformeRecepcionRenglon[]

  @@unique([empresaId, numero])
  @@unique([empresaId, terceroId, remitoNumero])
}

model InformeRecepcionRenglon {
  id                   String             @id @default(uuid()) @db.Uuid
  empresaId            String             @db.Uuid
  informeRecepcionId   String             @db.Uuid
  ordenCompraRenglonId String             @db.Uuid
  cantidad             Decimal            @db.Decimal(18, 4)
  cantidadFacturada    Decimal            @default(0) @db.Decimal(18, 4)
  informeRecepcion     InformeRecepcion   @relation(fields: [informeRecepcionId], references: [id])
  ordenCompraRenglon   OrdenCompraRenglon @relation(fields: [ordenCompraRenglonId], references: [id])
}

enum TipoComprobanteCompra {
  FACTURA
  NOTA_DEBITO
  NOTA_CREDITO
  TICKET
}

enum EstadoComprobante {
  CONFIRMADO
  ANULADO
}

enum OrigenRenglonCompra {
  RECEPCION
  ORDEN_COMPRA
  DIRECTO
}

model ComprobanteCompra {
  id                    String                            @id @default(uuid()) @db.Uuid
  empresaId             String                            @db.Uuid
  numeroInterno         Int
  terceroId             String                            @db.Uuid
  tipo                  TipoComprobanteCompra
  letra                 String                            @default("")
  puntoVenta            Int
  numero                Int
  fechaEmision          DateTime                          @db.Date
  fechaContable         DateTime                          @db.Date
  fechaVencimiento      DateTime                          @db.Date
  monedaCodigo          String
  cotizacion            Decimal                           @db.Decimal(18, 6)
  netoGravado           Decimal                           @db.Decimal(18, 2)
  iva                   Decimal                           @db.Decimal(18, 2)
  percepcionIva         Decimal                           @default(0) @db.Decimal(18, 2)
  impuestosInternos     Decimal                           @default(0) @db.Decimal(18, 2)
  noGravado             Decimal                           @default(0) @db.Decimal(18, 2)
  exento                Decimal                           @default(0) @db.Decimal(18, 2)
  total                 Decimal                           @db.Decimal(18, 2)
  totalPesos            Decimal                           @db.Decimal(18, 2)
  estado                EstadoComprobante                 @default(CONFIRMADO)
  comprobanteAsociadoId String?                           @db.Uuid
  asientoId             String?                           @db.Uuid
  asientoAnulacionId    String?                           @db.Uuid
  aceptoDiferencias     Boolean                           @default(false)
  motivoAnulacion       String?
  creadoPor             String
  creadoEn              DateTime                          @default(now())
  tercero               Tercero                           @relation(fields: [terceroId], references: [id])
  renglones             ComprobanteCompraRenglon[]
  ivas                  ComprobanteCompraIva[]
  percepcionesIibb      ComprobanteCompraPercepcionIibb[]

  @@unique([empresaId, numeroInterno])
  @@unique([empresaId, terceroId, tipo, letra, puntoVenta, numero])
  @@index([empresaId, fechaContable])
}

model ComprobanteCompraRenglon {
  id                        String              @id @default(uuid()) @db.Uuid
  empresaId                 String              @db.Uuid
  comprobanteId             String              @db.Uuid
  orden                     Int
  origen                    OrigenRenglonCompra
  informeRecepcionRenglonId String?             @db.Uuid
  ordenCompraRenglonId      String?             @db.Uuid
  articuloId                String?             @db.Uuid
  descripcion               String
  cantidad                  Decimal             @db.Decimal(18, 4)
  precioUnitario            Decimal             @db.Decimal(18, 4)
  bonificacionPct           Decimal             @default(0) @db.Decimal(18, 6)
  alicuotaIva               Decimal             @db.Decimal(18, 6)
  cuentaContableId          String              @db.Uuid
  centroCostoId             String?             @db.Uuid
  importe                   Decimal             @db.Decimal(18, 2)
  comprobante               ComprobanteCompra   @relation(fields: [comprobanteId], references: [id])
}

model ComprobanteCompraIva {
  id            String            @id @default(uuid()) @db.Uuid
  empresaId     String            @db.Uuid
  comprobanteId String            @db.Uuid
  alicuota      Decimal           @db.Decimal(18, 6)
  base          Decimal           @db.Decimal(18, 2)
  importe       Decimal           @db.Decimal(18, 2)
  comprobante   ComprobanteCompra @relation(fields: [comprobanteId], references: [id])
}

model ComprobanteCompraPercepcionIibb {
  id            String            @id @default(uuid()) @db.Uuid
  empresaId     String            @db.Uuid
  comprobanteId String            @db.Uuid
  jurisdiccion  String
  importe       Decimal           @db.Decimal(18, 2)
  comprobante   ComprobanteCompra @relation(fields: [comprobanteId], references: [id])
}

model MovimientoCuentaCorriente {
  id               String   @id @default(uuid()) @db.Uuid
  empresaId        String   @db.Uuid
  terceroId        String   @db.Uuid
  origenTipo       String
  origenId         String   @db.Uuid
  fecha            DateTime @db.Date
  fechaVencimiento DateTime @db.Date
  monedaCodigo     String
  importe          Decimal  @db.Decimal(18, 2)
  importePesos     Decimal  @db.Decimal(18, 2)
  saldo            Decimal  @db.Decimal(18, 2)
  saldoPesos       Decimal  @db.Decimal(18, 2)
  anulado          Boolean  @default(false)
  creadoEn         DateTime @default(now())

  @@index([empresaId, terceroId])
  @@index([empresaId, origenTipo, origenId])
}

enum SinPadron {
  NO_RETENER
  ALICUOTA_DEFECTO
}

model RegimenGanancias {
  id                  String    @id @default(uuid()) @db.Uuid
  empresaId           String    @db.Uuid
  codigo              String
  descripcion         String
  minimoNoSujeto      Decimal   @db.Decimal(18, 2)
  alicuotaInscripto   Decimal   @db.Decimal(18, 6)
  alicuotaNoInscripto Decimal   @db.Decimal(18, 6)
  usaEscala           Boolean   @default(false)
  minimoRetencion     Decimal   @db.Decimal(18, 2)
  activo              Boolean   @default(true)
  editadoEn           DateTime?

  @@unique([empresaId, codigo])
}

model EscalaGanancias {
  id         String   @id @default(uuid()) @db.Uuid
  empresaId  String   @db.Uuid
  desde      Decimal  @db.Decimal(18, 2)
  hasta      Decimal? @db.Decimal(18, 2)
  fijo       Decimal  @db.Decimal(18, 2)
  porcentaje Decimal  @db.Decimal(18, 6)
}

model JurisdiccionIibb {
  id              String    @id @default(uuid()) @db.Uuid
  empresaId       String    @db.Uuid
  jurisdiccion    String
  alicuotaDefecto Decimal   @default(0) @db.Decimal(18, 6)
  minimoRetencion Decimal   @default(0) @db.Decimal(18, 2)
  usaPadron       Boolean   @default(false)
  sinPadron       SinPadron @default(ALICUOTA_DEFECTO)

  @@unique([empresaId, jurisdiccion])
}

enum EstadoCarga {
  PROCESANDO
  COMPLETA
  ERROR
}

/// Padrón de IIBB: dato público, global (sin empresa).
model PadronIibb {
  id                 String   @id @default(uuid()) @db.Uuid
  jurisdiccion       String
  cuit               String
  vigenciaDesde      DateTime @db.Date
  vigenciaHasta      DateTime @db.Date
  alicuotaPercepcion Decimal? @db.Decimal(18, 6)
  alicuotaRetencion  Decimal? @db.Decimal(18, 6)

  @@unique([jurisdiccion, cuit, vigenciaDesde])
  @@index([jurisdiccion, vigenciaDesde])
}

model PadronCarga {
  id           String      @id @default(uuid()) @db.Uuid
  jurisdiccion String
  periodo      String?
  archivo      String
  estado       EstadoCarga @default(PROCESANDO)
  filas        Int         @default(0)
  error        String?
  creadoPor    String
  creadoEn     DateTime    @default(now())
}

enum EstadoOP {
  BORRADOR
  PENDIENTE_APROBACION
  APROBADA
  PAGADA
  ANULADA
}

model OrdenPago {
  id                 String                @id @default(uuid()) @db.Uuid
  empresaId          String                @db.Uuid
  numero             Int?
  terceroId          String                @db.Uuid
  fecha              DateTime              @db.Date
  cotizacion         Decimal               @default(1) @db.Decimal(18, 6)
  observaciones      String?
  estado             EstadoOP              @default(BORRADOR)
  totalCancelarPesos Decimal               @default(0) @db.Decimal(18, 2)
  totalRetenciones   Decimal               @default(0) @db.Decimal(18, 2)
  netoPagar          Decimal               @default(0) @db.Decimal(18, 2)
  fechaPago          DateTime?             @db.Date
  creadoPor          String
  creadoEn           DateTime              @default(now())
  aprobadoPor        String?
  aprobadoEn         DateTime?
  pagadoPor          String?
  motivoRechazo      String?
  motivoAnulacion    String?
  asientoId          String?               @db.Uuid
  asientoAnulacionId String?               @db.Uuid
  version            Int                   @default(0)
  tercero            Tercero               @relation(fields: [terceroId], references: [id])
  imputaciones       OrdenPagoImputacion[]
  anticipo           OrdenPagoAnticipo?
  retenciones        OrdenPagoRetencion[]
  medios             OrdenPagoMedio[]

  @@unique([empresaId, numero])
  @@index([empresaId, estado])
}

model OrdenPagoImputacion {
  id           String    @id @default(uuid()) @db.Uuid
  empresaId    String    @db.Uuid
  ordenPagoId  String    @db.Uuid
  movimientoId String    @db.Uuid
  importe      Decimal   @db.Decimal(18, 2)
  importePesos Decimal   @db.Decimal(18, 2)
  ordenPago    OrdenPago @relation(fields: [ordenPagoId], references: [id], onDelete: Cascade)

  @@index([empresaId, movimientoId])
}

model OrdenPagoAnticipo {
  id           String    @id @default(uuid()) @db.Uuid
  empresaId    String    @db.Uuid
  ordenPagoId  String    @unique @db.Uuid
  monedaCodigo String
  importe      Decimal   @db.Decimal(18, 2)
  ordenPago    OrdenPago @relation(fields: [ordenPagoId], references: [id], onDelete: Cascade)
}

model OrdenPagoRetencion {
  id                String    @id @default(uuid()) @db.Uuid
  empresaId         String    @db.Uuid
  ordenPagoId       String    @db.Uuid
  impuesto          String
  jurisdiccion      String?
  regimen           String?
  base              Decimal   @db.Decimal(18, 2)
  alicuota          String
  importe           Decimal   @db.Decimal(18, 2)
  detalle           Json
  certificadoNumero Int?
  anulada           Boolean   @default(false)
  ordenPago         OrdenPago @relation(fields: [ordenPagoId], references: [id], onDelete: Cascade)
}

enum TipoMedioPago {
  TRANSFERENCIA
  CHEQUE
  EFECTIVO
}

enum EstadoChequePropio {
  EMITIDO
  ANULADO
}

model OrdenPagoMedio {
  id               String        @id @default(uuid()) @db.Uuid
  empresaId        String        @db.Uuid
  ordenPagoId      String        @db.Uuid
  tipo             TipoMedioPago
  monedaCodigo     String
  importe          Decimal       @db.Decimal(18, 2)
  importePesos     Decimal       @db.Decimal(18, 2)
  cuentaBancariaId String?       @db.Uuid
  cajaId           String?       @db.Uuid
  chequeraId       String?       @db.Uuid
  chequeNumero     String?
  chequeFechaPago  DateTime?     @db.Date
  referencia       String?
  ordenPago        OrdenPago     @relation(fields: [ordenPagoId], references: [id], onDelete: Cascade)
}

model ChequePropio {
  id             String             @id @default(uuid()) @db.Uuid
  empresaId      String             @db.Uuid
  chequeraId     String             @db.Uuid
  numero         String
  fechaEmision   DateTime           @db.Date
  fechaPago      DateTime           @db.Date
  monedaCodigo   String
  importe        Decimal            @db.Decimal(18, 2)
  beneficiarioId String             @db.Uuid
  ordenPagoId    String             @db.Uuid
  estado         EstadoChequePropio @default(EMITIDO)

  @@unique([empresaId, chequeraId, numero])
}

model MovimientoTesoreria {
  id               String   @id @default(uuid()) @db.Uuid
  empresaId        String   @db.Uuid
  fecha            DateTime @db.Date
  tipo             String
  cuentaBancariaId String?  @db.Uuid
  cajaId           String?  @db.Uuid
  monedaCodigo     String
  importe          Decimal  @db.Decimal(18, 2)
  origenTipo       String
  origenId         String   @db.Uuid
  anulado          Boolean  @default(false)
  creadoEn         DateTime @default(now())

  @@index([empresaId, origenTipo, origenId])
}

model AplicacionCuentaCorriente {
  id                    String   @id @default(uuid()) @db.Uuid
  empresaId             String   @db.Uuid
  origenTipo            String
  origenId              String   @db.Uuid
  movimientoId          String   @db.Uuid
  importe               Decimal  @db.Decimal(18, 2)
  importePesosHistorico Decimal  @db.Decimal(18, 2)
  fecha                 DateTime @db.Date
  anulada               Boolean  @default(false)

  @@index([empresaId, movimientoId])
  @@index([empresaId, origenTipo, origenId])
}
