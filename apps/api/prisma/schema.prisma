datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum CondicionIva {
  RESPONSABLE_INSCRIPTO
  MONOTRIBUTO
  EXENTO
  CONSUMIDOR_FINAL
  NO_RESPONSABLE
}

model Empresa {
  id                 String       @id @default(uuid()) @db.Uuid
  razonSocial        String
  cuit               String
  condicionIva       CondicionIva
  domicilio          String?
  inicioEjercicioMes Int          @default(1)
  activa             Boolean      @default(true)
  creadoEn           DateTime     @default(now())

  agenteRetencionGanancias Boolean  @default(false)
  agenteRetencionIva       Boolean  @default(false)
  agenteRetencionSuss      Boolean  @default(false)
  /// Agente de percepción de IVA en las ventas (E39)
  agentePercepcionIva      Boolean  @default(false)
  codigoZonaSicoss         Int      @default(0)
  tipoEmpresaSicoss        Int      @default(1)
  jurisdiccionesIibb       String[]

  montoAprobacionOc          Decimal      @default(0) @db.Decimal(18, 2)
  toleranciaPrecioPct        Decimal      @default(2) @db.Decimal(18, 6)
  toleranciaCantidadPct      Decimal      @default(0) @db.Decimal(18, 6)
  modoTresVias               ModoTresVias @default(AVISAR)
  montoAprobacionOp          Decimal      @default(0) @db.Decimal(18, 2)
  diasToleranciaConciliacion Int          @default(5)

  puntosVenta PuntoVenta[]
  roles       Rol[]
  usuarios    UsuarioEmpresa[]
  cuentas     CuentaContable[]
}

model PuntoVenta {
  id          String  @id @default(uuid()) @db.Uuid
  empresaId   String  @db.Uuid
  numero      Int
  descripcion String?
  electronico Boolean @default(true)
  sucursalId  String? @db.Uuid
  depositoId  String? @db.Uuid
  empresa     Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, numero])
}

model Usuario {
  id           String           @id @default(uuid()) @db.Uuid
  email        String           @unique
  nombre       String
  passwordHash String
  superadmin   Boolean          @default(false)
  activo       Boolean          @default(true)
  creadoEn     DateTime         @default(now())
  empresas     UsuarioEmpresa[]
}

model Rol {
  id        String           @id @default(uuid()) @db.Uuid
  empresaId String           @db.Uuid
  nombre    String
  permisos  String[]
  empresa   Empresa          @relation(fields: [empresaId], references: [id])
  usuarios  UsuarioEmpresa[]

  @@unique([empresaId, nombre])
}

model UsuarioEmpresa {
  usuarioId  String    @db.Uuid
  empresaId  String    @db.Uuid
  rolId      String    @db.Uuid
  sucursalId String?   @db.Uuid
  activo     Boolean   @default(true)
  usuario    Usuario   @relation(fields: [usuarioId], references: [id])
  empresa    Empresa   @relation(fields: [empresaId], references: [id])
  rol        Rol       @relation(fields: [rolId], references: [id])
  /// E36: clave foránea (si se borra la sucursal, el usuario queda con acceso a todas)
  sucursal   Sucursal? @relation(fields: [sucursalId], references: [id], onDelete: SetNull)

  @@id([usuarioId, empresaId])
}

model Auditoria {
  id        String   @id @default(uuid()) @db.Uuid
  empresaId String   @db.Uuid
  usuarioId String   @db.Uuid
  entidad   String
  entidadId String
  accion    String
  datos     Json?
  fecha     DateTime @default(now())

  @@index([empresaId, entidad, entidadId])
}

model Talonario {
  id              String @id @default(uuid()) @db.Uuid
  empresaId       String @db.Uuid
  tipoComprobante String
  puntoVenta      Int
  ultimoNumero    Int    @default(0)

  @@unique([empresaId, tipoComprobante, puntoVenta])
}

model Tercero {
  id                      String              @id @default(uuid()) @db.Uuid
  empresaId               String              @db.Uuid
  codigo                  Int
  razonSocial             String
  nombreFantasia          String?
  cuit                    String
  tipoDocumento           TipoDocumento       @default(CUIT)
  situacionIibb           SituacionIibb?
  numeroIibb              String?
  condicionIva            CondicionIva
  esProveedor             Boolean             @default(false)
  esCliente               Boolean             @default(false)
  vendedorId              String?             @db.Uuid
  /// Exceptuado de los intereses por mora (Entrega 27).
  sinIntereses            Boolean             @default(false)
  domicilio               String?
  localidad               String?
  provincia               String?
  email                   String?
  telefono                String?
  diasPago                Int                 @default(0)
  regimenGanancias        String?
  exentoGanancias         Boolean             @default(false)
  exentoIva               Boolean             @default(false)
  regimenIvaId            String?             @db.Uuid
  regimenSussId           String?             @db.Uuid
  exclusionIvaPorcentaje  Int?
  exclusionIvaPublicacion DateTime?           @db.Date
  exclusionIvaHasta       DateTime?           @db.Date
  /// Beneficiario del exterior (E43): datos del F.2003 y régimen de Ganancias exterior
  residenteExterior       Boolean             @default(false)
  nif                     String?
  paisSire                Int?
  domicilioExterior       String?
  tipoPersona             String?
  nacimientoPais          Int?
  nacimientoFecha         DateTime?           @db.Date
  regimenExteriorId       String?             @db.Uuid
  aplicaCdi               Boolean             @default(false)
  acrecentamiento         Boolean             @default(false)
  exencionHasta           DateTime?           @db.Date
  inscriptoGanancias      Boolean             @default(true)
  activo                  Boolean             @default(true)
  creadoEn                DateTime            @default(now())
  iibb                    TerceroIibb[]
  ordenesCompra           OrdenCompra[]
  recepciones             InformeRecepcion[]
  comprobantesCompra      ComprobanteCompra[]
  ordenesPago             OrdenPago[]
  comprobantesVenta       ComprobanteVenta[]
  listaPreciosId          String?             @db.Uuid

  @@unique([empresaId, cuit])
  @@unique([empresaId, codigo])
  /// E50: obligación de recibir factura de crédito MiPyME (última consulta a ARCA y marca manual)
  fceObligado            Boolean?
  fceMontoMinimo         Decimal?      @db.Decimal(18, 2)
  fceConsultadoEn        DateTime?
  fceConsultadoAmbiente  AmbienteArca?
  fceObligadoManual      Boolean       @default(false)
}

model TerceroIibb {
  id                 String  @id @default(uuid()) @db.Uuid
  empresaId          String  @db.Uuid
  terceroId          String  @db.Uuid
  jurisdiccion       String
  /// Vacía = sin dato (E39); 0 = se percibe al 0 %
  alicuotaPercepcion Decimal? @db.Decimal(18, 6)
  alicuotaRetencion  Decimal @db.Decimal(18, 6)
  exento             Boolean @default(false)
  tercero            Tercero @relation(fields: [terceroId], references: [id], onDelete: Cascade)

  @@unique([terceroId, jurisdiccion])
}

enum TipoCuenta {
  ACTIVO
  PASIVO
  PATRIMONIO_NETO
  RESULTADO_POSITIVO
  RESULTADO_NEGATIVO
}

enum AjusteImpositivoCuenta {
  COMPUTABLE
  EXCLUIDO
}

enum AjusteImpositivoPartidaTipo {
  ACTIVO_INICIO
  PASIVO_INICIO
  DINAMICO
}

/// Partida manual del ajuste por inflación impositivo de un ejercicio (E45).
model AjusteImpositivoPartida {
  id          String                      @id @default(uuid()) @db.Uuid
  empresaId   String                      @db.Uuid
  ejercicioId String                      @db.Uuid
  concepto    String
  tipo        AjusteImpositivoPartidaTipo
  fecha       DateTime?                   @db.Date
  importe     Decimal                     @db.Decimal(18, 2)
  creadoPor   String
  creadoEn    DateTime                    @default(now())

  @@index([empresaId, ejercicioId])
}

model CuentaContable {
  id             String           @id @default(uuid()) @db.Uuid
  empresaId      String           @db.Uuid
  codigo         String
  nombre         String
  padreId        String?          @db.Uuid
  imputable      Boolean
  tipo           TipoCuenta
  activa         Boolean          @default(true)
  /// Para el ajuste por inflación: las no monetarias se reexpresan.
  monetaria      Boolean          @default(true)
  /// Cuenta donde se registra el ajuste por inflación de esta (p. ej. Capital → Ajuste de capital).
  cuentaAjusteId String?          @db.Uuid
  /// Ajuste por inflación impositivo (E45): activo o pasivo computable o excluido
  ajusteImpositivo AjusteImpositivoCuenta @default(COMPUTABLE)
  empresa        Empresa          @relation(fields: [empresaId], references: [id])
  padre          CuentaContable?  @relation("Jerarquia", fields: [padreId], references: [id])
  hijos          CuentaContable[] @relation("Jerarquia")
  cuentaAjuste   CuentaContable?  @relation("Ajuste", fields: [cuentaAjusteId], references: [id], onDelete: Restrict)
  ajustadas      CuentaContable[] @relation("Ajuste")

  @@unique([empresaId, codigo])
}

model Articulo {
  id             String  @id @default(uuid()) @db.Uuid
  empresaId      String  @db.Uuid
  codigo         String
  descripcion    String
  unidad         String  @default("UN")
  alicuotaIva    Decimal @db.Decimal(18, 6)
  cuentaCompraId String? @db.Uuid
  cuentaVentaId  String? @db.Uuid
  esServicio     Boolean @default(false)
  activo         Boolean @default(true)
  /// Stock (Entrega 10): lo mantiene el motor de stock
  controlaStock  Boolean @default(false)
  stockCantidad  Decimal @default(0) @db.Decimal(18, 4)
  stockValor     Decimal @default(0) @db.Decimal(18, 2)
  costoPromedio  Decimal @default(0) @db.Decimal(18, 6)

  @@unique([empresaId, codigo])
}

model Moneda {
  codigo  String @id
  nombre  String
  simbolo String
}

model Cotizacion {
  id           String   @id @default(uuid()) @db.Uuid
  empresaId    String   @db.Uuid
  monedaCodigo String
  fecha        DateTime @db.Date
  valor        Decimal  @db.Decimal(18, 6)

  @@unique([empresaId, monedaCodigo, fecha])
}

model CentroCosto {
  id        String  @id @default(uuid()) @db.Uuid
  empresaId String  @db.Uuid
  codigo    String
  nombre    String
  activo    Boolean @default(true)

  @@unique([empresaId, codigo])
}

model Deposito {
  id        String  @id @default(uuid()) @db.Uuid
  empresaId String  @db.Uuid
  codigo    String
  nombre    String
  direccion String?
  activo    Boolean @default(true)

  @@unique([empresaId, codigo])
}

enum TipoChequera {
  FISICA
  ECHEQ
}

model Banco {
  id         String           @id @default(uuid()) @db.Uuid
  empresaId  String           @db.Uuid
  nombre     String
  codigoBcra String?
  cuentas    CuentaBancaria[]
}

model CuentaBancaria {
  id               String     @id @default(uuid()) @db.Uuid
  empresaId        String     @db.Uuid
  bancoId          String     @db.Uuid
  numero           String
  cbu              String?
  alias            String?
  monedaCodigo     String
  cuentaContableId String     @db.Uuid
  activa           Boolean    @default(true)
  banco            Banco      @relation(fields: [bancoId], references: [id])
  chequeras        Chequera[]
}

model Chequera {
  id               String         @id @default(uuid()) @db.Uuid
  empresaId        String         @db.Uuid
  cuentaBancariaId String         @db.Uuid
  tipo             TipoChequera
  desde            Int?
  hasta            Int?
  proximoNumero    Int?
  activa           Boolean        @default(true)
  cuentaBancaria   CuentaBancaria @relation(fields: [cuentaBancariaId], references: [id])
}

model Sucursal {
  id        String           @id @default(uuid()) @db.Uuid
  empresaId String           @db.Uuid
  codigo    String
  nombre    String
  domicilio String?
  esCentral Boolean          @default(false)
  activa    Boolean          @default(true)
  cajas     Caja[]
  usuarios  UsuarioEmpresa[]

  @@unique([empresaId, codigo])
}

model Caja {
  id               String   @id @default(uuid()) @db.Uuid
  empresaId        String   @db.Uuid
  sucursalId       String   @db.Uuid
  nombre           String
  monedaCodigo     String
  cuentaContableId String   @db.Uuid
  activa           Boolean  @default(true)
  sucursal         Sucursal @relation(fields: [sucursalId], references: [id])
}

enum ModoTresVias {
  AVISAR
  BLOQUEAR
}

model ConfigCuenta {
  id               String @id @default(uuid()) @db.Uuid
  empresaId        String @db.Uuid
  concepto         String
  cuentaContableId String @db.Uuid

  @@unique([empresaId, concepto])
}

model Asiento {
  id               String           @id @default(uuid()) @db.Uuid
  empresaId        String           @db.Uuid
  numero           Int
  fecha            DateTime         @db.Date
  descripcion      String
  origenTipo       String
  origenId         String
  anulaAId         String?          @db.Uuid
  creadoPor        String
  creadoEn         DateTime         @default(now())
  tipo             TipoAsiento      @default(AUTOMATICO)
  ejercicioId      String?          @db.Uuid
  numeroDefinitivo Int?
  version          Int              @default(0)
  renglones        AsientoRenglon[]

  @@unique([empresaId, numero])
  @@unique([empresaId, ejercicioId, numeroDefinitivo])
  @@index([empresaId, origenTipo, origenId])
  @@index([empresaId, ejercicioId, fecha])
}

model AsientoRenglon {
  id               String    @id @default(uuid()) @db.Uuid
  empresaId        String    @db.Uuid
  asientoId        String    @db.Uuid
  cuentaContableId String    @db.Uuid
  centroCostoId    String?   @db.Uuid
  debe             Decimal   @default(0) @db.Decimal(18, 2)
  haber            Decimal   @default(0) @db.Decimal(18, 2)
  detalle          String?
  /// Fecha de origen para el ajuste por inflación (p. ej. alta del bien de uso); si falta, la del asiento
  fechaOrigen      DateTime? @db.Date
  asiento          Asiento   @relation(fields: [asientoId], references: [id])

  @@index([empresaId, cuentaContableId])
}

enum EstadoOC {
  BORRADOR
  PENDIENTE_APROBACION
  APROBADA
  PARCIALMENTE_RECIBIDA
  CUMPLIDA
  ANULADA
}

model OrdenCompra {
  id              String               @id @default(uuid()) @db.Uuid
  empresaId       String               @db.Uuid
  numero          Int?
  puntoVenta      Int                  @default(1)
  terceroId       String               @db.Uuid
  fecha           DateTime             @db.Date
  fechaEntrega    DateTime?            @db.Date
  depositoId      String?              @db.Uuid
  monedaCodigo    String
  cotizacion      Decimal              @default(1) @db.Decimal(18, 6)
  diasPago        Int                  @default(0)
  observaciones   String?
  estado          EstadoOC             @default(BORRADOR)
  neto            Decimal              @default(0) @db.Decimal(18, 2)
  iva             Decimal              @default(0) @db.Decimal(18, 2)
  total           Decimal              @default(0) @db.Decimal(18, 2)
  totalPesos      Decimal              @default(0) @db.Decimal(18, 2)
  creadoPor       String
  creadoEn        DateTime             @default(now())
  aprobadoPor     String?
  aprobadoEn      DateTime?
  motivoRechazo   String?
  motivoAnulacion String?
  cerradaEn       DateTime?
  cerradaPor      String?
  version         Int                  @default(0)
  tercero         Tercero              @relation(fields: [terceroId], references: [id])
  renglones       OrdenCompraRenglon[]

  @@unique([empresaId, puntoVenta, numero])
  @@index([empresaId, estado])
}

model OrdenCompraRenglon {
  id                String                    @id @default(uuid()) @db.Uuid
  empresaId         String                    @db.Uuid
  ordenCompraId     String                    @db.Uuid
  orden             Int
  articuloId        String?                   @db.Uuid
  descripcion       String
  cantidad          Decimal                   @db.Decimal(18, 4)
  precioUnitario    Decimal                   @db.Decimal(18, 4)
  bonificacionPct   Decimal                   @default(0) @db.Decimal(18, 6)
  alicuotaIva       Decimal                   @db.Decimal(18, 6)
  centroCostoId     String?                   @db.Uuid
  importe           Decimal                   @db.Decimal(18, 2)
  cantidadRecibida  Decimal                   @default(0) @db.Decimal(18, 4)
  cantidadFacturada Decimal                   @default(0) @db.Decimal(18, 4)
  ordenCompra       OrdenCompra               @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)
  recepciones       InformeRecepcionRenglon[]
}

enum EstadoIR {
  CONFIRMADO
  ANULADO
}

model InformeRecepcion {
  id                 String                    @id @default(uuid()) @db.Uuid
  empresaId          String                    @db.Uuid
  numero             Int
  terceroId          String                    @db.Uuid
  fecha              DateTime                  @db.Date
  depositoId         String?                   @db.Uuid
  remitoNumero       String
  observaciones      String?
  estado             EstadoIR                  @default(CONFIRMADO)
  motivoAnulacion    String?
  asientoId          String?                   @db.Uuid
  asientoAnulacionId String?                   @db.Uuid
  creadoPor          String
  creadoEn           DateTime                  @default(now())
  tercero            Tercero                   @relation(fields: [terceroId], references: [id])
  renglones          InformeRecepcionRenglon[]

  @@unique([empresaId, numero])
  @@unique([empresaId, terceroId, remitoNumero])
}

model InformeRecepcionRenglon {
  id                   String             @id @default(uuid()) @db.Uuid
  empresaId            String             @db.Uuid
  informeRecepcionId   String             @db.Uuid
  ordenCompraRenglonId String             @db.Uuid
  cantidad             Decimal            @db.Decimal(18, 4)
  cantidadFacturada    Decimal            @default(0) @db.Decimal(18, 4)
  informeRecepcion     InformeRecepcion   @relation(fields: [informeRecepcionId], references: [id])
  ordenCompraRenglon   OrdenCompraRenglon @relation(fields: [ordenCompraRenglonId], references: [id])
}

enum TipoComprobanteCompra {
  FACTURA
  NOTA_DEBITO
  NOTA_CREDITO
  TICKET
  DESPACHO_IMPORTACION
}

enum EstadoComprobante {
  CONFIRMADO
  ANULADO
}

enum OrigenRenglonCompra {
  RECEPCION
  ORDEN_COMPRA
  DIRECTO
}

model ComprobanteCompra {
  id                    String                            @id @default(uuid()) @db.Uuid
  empresaId             String                            @db.Uuid
  numeroInterno         Int
  terceroId             String                            @db.Uuid
  tipo                  TipoComprobanteCompra
  letra                 String                            @default("")
  puntoVenta            Int
  numero                Int
  fechaEmision          DateTime                          @db.Date
  fechaContable         DateTime                          @db.Date
  fechaVencimiento      DateTime                          @db.Date
  monedaCodigo          String
  cotizacion            Decimal                           @db.Decimal(18, 6)
  netoGravado           Decimal                           @db.Decimal(18, 2)
  iva                   Decimal                           @db.Decimal(18, 2)
  percepcionIva         Decimal                           @default(0) @db.Decimal(18, 2)
  destinoCreditoIva     DestinoCreditoIva                 @default(GRAVADO)
  /// Despacho de importación (E41): número del despacho, percepción de Ganancias y tributos al costo
  numeroDespacho        String?
  percepcionGanancias   Decimal                           @default(0) @db.Decimal(18, 2)
  derechosImportacion   Decimal                           @default(0) @db.Decimal(18, 2)
  tasaEstadistica       Decimal                           @default(0) @db.Decimal(18, 2)
  impuestosInternos     Decimal                           @default(0) @db.Decimal(18, 2)
  noGravado             Decimal                           @default(0) @db.Decimal(18, 2)
  exento                Decimal                           @default(0) @db.Decimal(18, 2)
  total                 Decimal                           @db.Decimal(18, 2)
  totalPesos            Decimal                           @db.Decimal(18, 2)
  estado                EstadoComprobante                 @default(CONFIRMADO)
  comprobanteAsociadoId String?                           @db.Uuid
  asientoId             String?                           @db.Uuid
  depositoId            String?                           @db.Uuid
  asientoAnulacionId    String?                           @db.Uuid
  aceptoDiferencias     Boolean                           @default(false)
  /// E50: factura de crédito electrónica MiPyME recibida (numeración propia del proveedor)
  fce                   Boolean                           @default(false)
  motivoAnulacion       String?
  creadoPor             String
  creadoEn              DateTime                          @default(now())
  tercero               Tercero                           @relation(fields: [terceroId], references: [id])
  renglones             ComprobanteCompraRenglon[]
  ivas                  ComprobanteCompraIva[]
  percepcionesIibb      ComprobanteCompraPercepcionIibb[]

  @@unique([empresaId, numeroInterno])
  @@unique([empresaId, terceroId, tipo, letra, fce, puntoVenta, numero])
  @@index([empresaId, fechaContable])

  @@unique([empresaId, numeroDespacho])
}

model ComprobanteCompraRenglon {
  id                        String              @id @default(uuid()) @db.Uuid
  empresaId                 String              @db.Uuid
  comprobanteId             String              @db.Uuid
  orden                     Int
  origen                    OrigenRenglonCompra
  informeRecepcionRenglonId String?             @db.Uuid
  ordenCompraRenglonId      String?             @db.Uuid
  articuloId                String?             @db.Uuid
  descripcion               String
  cantidad                  Decimal             @db.Decimal(18, 4)
  precioUnitario            Decimal             @db.Decimal(18, 4)
  bonificacionPct           Decimal             @default(0) @db.Decimal(18, 6)
  alicuotaIva               Decimal             @db.Decimal(18, 6)
  cuentaContableId          String              @db.Uuid
  centroCostoId             String?             @db.Uuid
  importe                   Decimal             @db.Decimal(18, 2)
  comprobante               ComprobanteCompra   @relation(fields: [comprobanteId], references: [id])
}

model ComprobanteCompraIva {
  id            String            @id @default(uuid()) @db.Uuid
  empresaId     String            @db.Uuid
  comprobanteId String            @db.Uuid
  alicuota      Decimal           @db.Decimal(18, 6)
  base          Decimal           @db.Decimal(18, 2)
  importe       Decimal           @db.Decimal(18, 2)
  comprobante   ComprobanteCompra @relation(fields: [comprobanteId], references: [id])
}

model ComprobanteCompraPercepcionIibb {
  id            String            @id @default(uuid()) @db.Uuid
  empresaId     String            @db.Uuid
  comprobanteId String            @db.Uuid
  jurisdiccion  String
  importe       Decimal           @db.Decimal(18, 2)
  comprobante   ComprobanteCompra @relation(fields: [comprobanteId], references: [id])
}

model MovimientoCuentaCorriente {
  id               String   @id @default(uuid()) @db.Uuid
  empresaId        String   @db.Uuid
  terceroId        String   @db.Uuid
  origenTipo       String
  origenId         String   @db.Uuid
  fecha            DateTime @db.Date
  fechaVencimiento DateTime @db.Date
  monedaCodigo     String
  importe          Decimal  @db.Decimal(18, 2)
  importePesos     Decimal  @db.Decimal(18, 2)
  saldo            Decimal  @db.Decimal(18, 2)
  saldoPesos       Decimal  @db.Decimal(18, 2)
  anulado          Boolean  @default(false)
  creadoEn         DateTime @default(now())

  @@index([empresaId, terceroId])
  @@index([empresaId, origenTipo, origenId])
}

enum SinPadron {
  NO_RETENER
  ALICUOTA_DEFECTO
}

model RegimenGanancias {
  id                  String    @id @default(uuid()) @db.Uuid
