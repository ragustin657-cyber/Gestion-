{
  "name": "@gestion/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @gestion/shared build && prisma generate && tsc -p tsconfig.build.json",
    "dev": "pnpm --filter @gestion/shared build && ts-node-dev --respawn --transpile-only src/main.ts",
    "start": "node dist/src/main.js",
    "test": "jest --runInBand",
    "test:e2e": "jest --runInBand",
    "seed": "pnpm --filter @gestion/shared build && ts-node --transpile-only prisma/seed.ts",
    "prisma": "prisma"
  },
  "dependencies": {
    "@gestion/shared": "workspace:*",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.8",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.12.0",
    "nestjs-cls": "^5.4.3",
    "node-forge": "^1.4.3",
    "pdfkit": "~0.15.2",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.8",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/node-forge": "^1.3.14",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
