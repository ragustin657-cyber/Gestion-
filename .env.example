DATABASE_URL=postgresql://gestion:gestion@localhost:5432/gestion
DATABASE_URL_TEST=postgresql://gestion:gestion@localhost:5432/gestion_test
JWT_SECRET=cambiar-este-secreto
PORT=3000
# Clave para cifrar los certificados de ARCA (32 bytes en base64): openssl rand -base64 32
ARCA_CLAVE_MAESTRA=

# Saltos de proxy delante de la API (límite de intentos de login por IP). 1 si hay un proxy como el nginx del docker-compose.
# No lo definas si la API recibe conexiones directas: un cliente podría falsear X-Forwarded-For.
TRUST_PROXY=
